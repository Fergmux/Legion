class_name CardDB
extends RefCounted
## Static card definitions loaded from data/cards.json (generated by tools/import_cards.py).
## Definitions are shared and never mutated; per-game state lives on card instances.

const CARDS_PATH := "res://data/cards.json"

const BUFFS := ["retain", "eternal", "pierce", "cleanse", "medic", "infiltrate", "nimble"]
const DEBUFFS := ["reveal", "burn", "paralyse", "curse", "poison", "blind", "debilitate"]
const STATUS_ORDER := ["retain", "eternal", "pierce", "cleanse", "medic", "infiltrate", "nimble",
	"reveal", "burn", "paralyse", "curse", "poison", "blind", "debilitate"]

const TYPE_ADVANTAGE := {
	"Water": "Fire", "Fire": "Earth", "Earth": "Lightning", "Lightning": "Water",
	"Light": "Dark", "Dark": "Physical", "Physical": "Light",
}
const ELEMENTS := ["Water", "Fire", "Earth", "Lightning", "Light", "Dark", "Physical"]
const RACES := ["Mage", "Dragon", "Warrior", "Beast", "Monster", "God"]

const STATUS_HELP := {
	"rune": "Rune: a unit with enough Runes can be tributed for an Arcane summon. Unaffected by Curse.",
	"retain": "Retain: not discarded at end of turn. One stack is consumed each time it prevents a discard.",
	"reveal": "Reveal: this card is face up. Permanent.",
	"eternal": "Eternal: prevents the next destruction of this unit (one stack consumed). Battle HP damage still applies.",
	"burn": "Burn: when this unit attacks, its controller takes Damage equal to Burn, then all Burn is removed.",
	"pierce": "Pierce: attacking a Defense-stance unit, excess ATK damages the opponent. One stack consumed.",
	"cleanse": "Cleanse: removes all existing debuffs or prevents an incoming debuff. One stack consumed per use.",
	"paralyse": "Paralyse: cannot declare an attack, move zones or change stance (a stance change forced by a card still happens). -1 at the end of its controller's turn.",
	"medic": "Medic: at the start of its controller's turn they Heal HP equal to Medic, then -1.",
	"curse": "Curse: removes all buffs or prevents an incoming buff (not Runes). One stack consumed per use.",
	"poison": "Poison: at the end of its controller's turn they take Damage equal to Poison, then -1.",
	"infiltrate": "Infiltrate: may attack protected units. One stack consumed when it does.",
	"blind": "Blind: attack target is chosen at random among legal targets. One stack consumed when it attacks.",
	"nimble": "Nimble: once per turn move to an adjacent empty zone (diagonals count). One stack consumed per move.",
	"debilitate": "Debilitate: cannot be sacrificed or tributed; all its effects are suppressed. -1 at the end of its controller's turn.",
}

static var _defs: Dictionary = {}
static var _notes: Array = []


## Loads definitions once. Safe to call repeatedly.
static func ensure_loaded() -> void:
	if not _defs.is_empty():
		return
	var text := FileAccess.get_file_as_string(CARDS_PATH)
	var data: Dictionary = JSON.parse_string(text)
	for c in data["cards"]:
		c["id"] = int(c["id"])
		if c["cost"] != null:
			c["cost"] = int(c["cost"])
		if c["atk"] != null:
			c["atk"] = int(c["atk"])
		if c["def"] != null:
			c["def"] = int(c["def"])
		_defs[c["id"]] = c
	_notes = data["unassigned_source_notes"]


## Returns the shared definition for a card id.
static func get_def(id: int) -> Dictionary:
	ensure_loaded()
	return _defs[id]


static func has(id: int) -> bool:
	ensure_loaded()
	return _defs.has(id)


## All definitions in source order (the 2026-10-18 export repeats some indices; ties go by id).
## A card with no sheet index (the 3 Nov 2026 new cards: null) sorts after every indexed card.
## Rules code iterates this; lists the player sees use catalogue order (collectible, sort_ids).
static func all() -> Array:
	ensure_loaded()
	var out := _defs.values()
	out.sort_custom(func(a, b): return _order_before(a, b))
	return out


## Source-order comparison of two definitions: by sheet index (none = last), then by id.
static func _order_before(a: Dictionary, b: Dictionary) -> bool:
	var ia = a["source"].get("index")
	var ib = b["source"].get("index")
	var na := ia == null
	var nb := ib == null
	if na != nb:
		return nb                         # an indexed card comes before one without an index
	if not na and float(ia) != float(ib):
		return float(ia) < float(ib)
	return int(a["id"]) < int(b["id"])


## L23 Transform: the card id `id` transforms into, or -1 when it has no Transform section.
static func transforms_into(id: int) -> int:
	if not has(id):
		return -1
	var nxt = _defs[id].get("transforms_into")
	return -1 if nxt == null else int(nxt)


## Cards switched off for now (owner, 2026-11-10: "temporarily remove it from the game, keep the code").
## Add or remove an id here to turn a card off or on; nothing else needs changing. A disabled card
## keeps its data and script, stays listed (greyed, "Disabled") in the deck builder and the card
## library, cannot be added to a deck, is never drafted, offered as a reward or put in a starter deck,
## and a saved deck that holds it plays without it (MatchEngine.setup).
const DISABLED := [
	44,   # Draw Virus
]


## True when card `id` is switched off (DISABLED).
static func is_disabled(id: int) -> bool:
	return DISABLED.has(id)


## Deck `ids` without its disabled cards: what a game is actually played with.
static func playable_deck(ids: Array) -> Array:
	return ids.filter(func(i): return not is_disabled(int(i)))


## L23: true for a card players can own as a card: drafted, offered as a reward, put in a deck,
## listed in the deck builder and the card library. False for a transformation-only form (Symbiote
## Larva, Symbiote Siphonophore): it exists only by transforming its base card during a game, and is
## reached in the catalogue through that card's "Transforms into" preview. False for an unknown id.
## The one predicate every collection surface calls.
static func is_collectible(id: int) -> bool:
	if not has(id):
		return false
	return not _transformation_bases().has(id)


## M8: every collectible definition (is_collectible) in catalogue order (catalogue_before): by card
## kind first, so a card with no sheet index sits among the other cards of its kind. Every card
## list the player sees (deck builder catalogue and deck, card library, pile views) follows it.
static func collectible() -> Array:
	var out := all().filter(func(d): return is_collectible(int(d["id"])))
	out.sort_custom(func(a, b): return catalogue_before(a, b))
	return out


## M8: card kinds in the order every list shows them (the sheet's own grouping): Basic units, Units,
## Spells, Traps, Powers, then the Extra Deck's Fusions, Arcanes and Spirits.
const KIND_ORDER := ["basic_unit", "unit", "spell", "trap", "power", "fusion", "arcane", "spirit"]


## M8: position of card kind `category` in KIND_ORDER (an unknown kind after every known one).
static func kind_rank(category: String) -> int:
	var i := KIND_ORDER.find(category)
	return KIND_ORDER.size() if i == -1 else i


## M8: catalogue comparison of two definitions: by kind (KIND_ORDER), then source order within the
## kind (_order_before: sheet index, a card without one after the indexed cards of its kind, by id).
## all() keeps plain source order (rules code draws from it; its order feeds seeded draws).
static func catalogue_before(a: Dictionary, b: Dictionary) -> bool:
	var ka := kind_rank(String(a["category"]))
	var kb := kind_rank(String(b["category"]))
	if ka != kb:
		return ka < kb
	return _order_before(a, b)


## M8: card id -> position in catalogue order over every definition (transformation-only forms included,
## so any id a list may hold has a place). Built once.
static func catalogue_rank() -> Dictionary:
	if _rank.is_empty():
		var defs := all()
		defs.sort_custom(func(a, b): return catalogue_before(a, b))
		for i in defs.size():
			_rank[int(defs[i]["id"])] = i
	return _rank


static var _rank: Dictionary = {}


## M8: card ids (ints; duplicates kept) in catalogue order; unknown ids last, by id.
static func sort_ids(ids: Array) -> Array:
	var rank := catalogue_rank()
	var out := ids.duplicate()
	out.sort_custom(func(a, b):
		var ra: int = rank.get(int(a), 1 << 30)
		var rb: int = rank.get(int(b), 1 << 30)
		return ra < rb if ra != rb else int(a) < int(b))
	return out


## L23: the collectible card a transformation-only form transforms from (the start of its chain:
## Siphonophore -> Spawn); the id itself for any other card.
static func transformation_base(id: int) -> int:
	var bases := _transformation_bases()
	var cur := id
	var guard := 0
	while bases.has(cur) and guard < 16:
		cur = int(bases[cur])
		guard += 1
	return cur


## L23: deck `ids` with every transformation-only form replaced by its base card (a deck or series saved
## before 5 Nov 2026 may hold Symbiote Larva / Siphonophore as separate cards). Mapping keeps the
## deck's size and its Symbiote: the player owns a Spawn that can transform into what they had. Unknown
## ids are kept (the callers report them). Returns a new array of ints.
static func sanitize_deck(ids: Array) -> Array:
	var out := []
	for i in ids:
		var id := int(i)
		out.append(transformation_base(id) if has(id) else id)
	return out


## Transformed form -> the card it transforms from, built once from the definitions.
static var _bases_cache: Dictionary = {}
static var _bases_built := false


static func _transformation_bases() -> Dictionary:
	ensure_loaded()
	if not _bases_built:
		_bases_built = true
		for id in _defs:
			var nxt = _defs[id].get("transforms_into")
			if nxt != null:
				_bases_cache[int(nxt)] = int(id)
	return _bases_cache


static func unassigned_notes() -> Array:
	ensure_loaded()
	return _notes


static func is_unit_category(cat: String) -> bool:
	return cat in ["basic_unit", "unit", "fusion", "arcane", "spirit"]


static func is_extra_category(cat: String) -> bool:
	return cat in ["fusion", "arcane", "spirit"]


static func is_buff(status: String) -> bool:
	return status in BUFFS


static func is_debuff(status: String) -> bool:
	return status in DEBUFFS


## Human-readable cost string that keeps the cost kinds distinct.
static func cost_label(d: Dictionary, current = null) -> String:
	match d["cost_kind"]:
		"fusion":
			return "Fusion"
		"arcane":
			var r = current if current != null else d["cost"]
			return ("?" if r == null else str(r)) + " Rune"
		"spirit":
			return str(current if current != null else d["cost"]) + " Spirit"
	return str(current if current != null else d["cost"]) + " AP"
